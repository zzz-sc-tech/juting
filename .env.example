APP_NAME=JuTing Backend
APP_HOST=127.0.0.1
APP_PORT=8100
APP_SCHEMA=http
APP_ROUTE_PREFIX=/api
APP_BANNER=true
APP_ENV=development
APP_BACKEND_URL=http://127.0.0.1:8100
CORS_ORIGINS=http://127.0.0.1:8101,http://localhost:8101,http://127.0.0.1:8102,http://localhost:8102
VITE_API_BASE_URL=http://127.0.0.1:8100
AUTH_TOKEN_SECRET=dev-auth-token-secret
SECRET_JWT=dev-auth-token-secret
LOG_LEVEL=info
LOG_JSON=false
LOG_OUTPUT=dev
MONITOR_ENABLED=false
MONITOR_ROUTE=/status
MONITOR_USERNAME=admin
MONITOR_PASSWORD=admin

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=duolinting_app_dev
MYSQL_USER=root
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_LOGGING=false
MYSQL_ROOT_PASSWORD=duolinting-root

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=duolinting-media
MINIO_REGION=us-east-1
# 可选：公开媒体入口。生产环境可设置为 Cloudflare 代理的 HTTPS 路径，
# 如 https://<learner-domain>/media；留空则继续由 /api/v1/media/objects 提供媒体。
MEDIA_PUBLIC_BASE_URL=
# 媒体存储后端：minio（默认，生产）或 local（单机免 MinIO，媒体直接落本地磁盘）。
# local 模式面向本地单机部署/演示；预签名上传（upload-intents）在该模式下不可用。
MEDIA_STORAGE=minio
MEDIA_LOCAL_DIR=
RESEND_API_KEY=

# 仅本机开发的上传进度演练。默认 0 为关闭；生产环境和非环回请求会强制忽略。
# 例如 256 代表将媒体/封面上传限制为约 256 KB/s，方便观察前端进度条。
LOCAL_UPLOAD_THROTTLE_KBPS=0
# 文件发送与对象存储写入完成后，额外等待多久再返回成功，用于测试“等待服务器确认”。
LOCAL_UPLOAD_CONFIRMATION_DELAY_MS=0

# ── 自动切分（本地离线语音识别，可选）──────────────────────────
# 制课工作台用 whisper.cpp 把课程音频本地转写为逐句字幕；音频不上传任何第三方服务。
# 启用需要三步：安装 whisper.cpp 可执行文件、下载 ggml 模型、在 backend/.env 配置以下变量。
# 详细部署说明见 docs/asr-auto-segmentation.md。
ASR_ENABLED=false
# whisper.cpp 命令行可执行文件绝对路径（Windows 示例：D:/asr/whisper-bin/whisper-cli.exe）
ASR_WHISPER_BIN=
# ggml 模型文件绝对路径；四六级中英混听推荐 multilingual small 模型（ggml-small.bin）。
# 提速技巧：用 whisper-quantize.exe 把 f16 模型量化为 q5_1（体积减半、速度快约 20%，
# 识别质量实测无损）：whisper-quantize.exe ggml-small.bin ggml-small-q5_1.bin q5_1
ASR_WHISPER_MODEL=
# 默认识别语言：auto=自动检测，也可固定 en / zh
ASR_LANGUAGE=auto
# whisper 线程数：默认 8。实测 8 线程比 whisper.cpp 自带默认（4）快约 36%；
# 8 核以上机器可试 12~16。修改后重启后端生效。
ASR_THREADS=8
# whisper 初始提示词（--prompt）。注意实测：中文提示词在 auto 语言下会抑制英文段落，
# 中英混合的四六级音频请保持为空；纯中文材料可设 zh 语言并填「以下是普通话的句子。」
# 把输出偏置为简体。留空时锚点提取也不受影响（内置指令句繁转简兜底）。
ASR_INITIAL_PROMPT=
# ffmpeg 可执行文件（用于把任意音频/视频转成 whisper 需要的 16kHz 单声道 WAV）
ASR_FFMPEG_BIN=ffmpeg
# 「一键准备」的下载源：模型走 HuggingFace 镜像，引擎为 GitHub whisper.cpp 预编译包
ASR_MODEL_BASE_URL=https://hf-mirror.com
ASR_BINARY_URL=
# 同时运行的识别进程数（CPU 密集，默认串行）；单媒体大小上限（MB）；临时工作目录
ASR_MAX_CONCURRENCY=1
ASR_MAX_MEDIA_MB=200
ASR_WORK_DIR=
# whisper 的 max-context（-mc N）。默认 -1 保持 whisper 自带行为（把前文当解码条件）；
# 实测在长音频（20 分钟以上）上保留前文会诱发「注入式幻觉」——凭空生成
# "Conversation 12-However,…"、"Questions 17. …" 之类并不存在的句子，并把同一段
# 说明揉成 20～30 秒的巨段。英文考试音频建议设 0（每段独立解码）：幻觉消失，
# 分段粒度也更贴近句子边界。修改后重跑识别（同一音频会重新入队）才生效。
ASR_MAX_CONTEXT=-1
